// Try Prisma Accelerate: https://pris.ly/cli/accelerate-init

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model Smartphone {
  id       Int    @id @default(autoincrement())
  kode     String @unique
  nama     String
  harga    Float
  ram      Float
  storage  Float
  baterai  Float
  kamera   Float
}

model Kriteria {
  id     Int    @id @default(autoincrement())
  kode   String @unique
  nama   String
  bobot  Float
  sifat  String // "benefit" or "cost"
}

model ProfilIdeal {
  id      Int   @id @default(autoincrement())
  harga   Float
  ram     Float
  storage Float
  baterai Float
  kamera  Float
}

model HasilSAW {
  id          Int    @id @default(autoincrement())
  smartphone  String
  nilai       Float
  ranking     Int
}

model HasilSMART {
  id          Int    @id @default(autoincrement())
  smartphone  String
  nilai       Float
  ranking     Int
}

model HasilPM {
  id          Int    @id @default(autoincrement())
  smartphone  String
  nilai       Float
  ranking     Int
}

model HasilGP {
  id          Int    @id @default(autoincrement())
  smartphone  String
  jarak       Float
  waktu       Float
  biaya       Float
  nilaiZ      Float
  ranking     Int
}